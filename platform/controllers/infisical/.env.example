# Bootstrap secrets for the Infisical self-hosted instance.
# Consumed by: kubectl create secret generic infisical-secrets -n infisical --from-env-file=...
# Do NOT commit the real .env file — it is gitignored.

# Random 32-byte base64 string. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Random 16-byte hex string. Generate with: openssl rand -hex 16
# WARNING: store this outside the cluster. Losing it means encrypted data
# in the Infisical database cannot be recovered, even from a DB backup.
ENCRYPTION_KEY=

# Public URL where Infisical will be reached. Must match the ingress hostName
# configured in helm-release.yaml.
SITE_URL=https://infisical.example.com

# Required so the Kubernetes Auth machine identity can point at
# https://kubernetes.default.svc.cluster.local (which resolves to a private
# ClusterIP). Without this flag Infisical rejects the URL as "Local IPs not
# allowed" via its SSRF validator.
ALLOW_INTERNAL_IP_CONNECTIONS=true
